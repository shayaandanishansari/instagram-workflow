node_modules/
dist/
.DS_Store
*.local

# API keys (see .env.example)
.env

# Editor / IDE
.idea/
.vscode/

# Local-only backup of the pre-refactor single-file version (not for publishing)
_legacy/

# Private artwork: keep the folder + its README tracked, but never publish the
# images themselves. The app falls back to placeholders when they're absent, so
# a fresh clone still builds. Un-ignore a specific safe file to ship a sample,
# e.g.  !src/assets/logo.png
src/assets/*
!src/assets/README.md
# EXCEPTION — Stu's own product artwork (logo, app screenshots). Published
# deliberately so the Stu team can work on their decks from this repo. It is the
# team's own product, not somebody else's submission. Every OTHER project's
# images stay ignored.
!src/assets/stu/

# Raw form submissions (the drop-zone). These contain PII — names, emails,
# WhatsApp numbers, private team photos — so the contents are NEVER published.
# Keep the folder + its README tracked so the workflow is documented on a
# fresh clone. Drop each downloaded submission folder in here.
submissions/*
!submissions/README.md

# Deck files. A deck is CONTENT derived from a submission: it carries real team
# members' full names, their quotes and their social handles — the same PII the
# two rules above exist to protect. So the decks themselves are never published.
#
# Tracked exceptions: the registry (code, no PII), the folder's README, and
# example.js — an invented deck that is safe to publish and doubles as the
# template. A fresh clone therefore still builds and runs, with placeholders.
src/data/projects/*
!src/data/projects/index.js
!src/data/projects/example.js
!src/data/projects/README.md

# EXCEPTION — the Stu decks. Published deliberately (owner's call) so the Stu
# team can collaborate on them here. stu.js does carry the team's own full names
# and quotes; that is accepted for THESE FOUR FILES ONLY. Every other deck in
# this folder is somebody else's data and stays ignored — do not add to this
# list without the deck subject's say-so.
!src/data/projects/stu.js
!src/data/projects/stu-beta.js
!src/data/projects/stu-beta-story.js
!src/data/projects/stu-live.js
