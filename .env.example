# Copy this file to .env and fill in your own key. Never commit .env.
#
# Used by scripts/download-drive.js to pull files/folders straight from
# Google Drive links instead of downloading + re-uploading by hand.
#
# Get a free key: console.cloud.google.com -> APIs & Services -> Library ->
# enable "Google Drive API" -> Credentials -> Create credentials -> API key.
GOOGLE_DRIVE_API_KEY=paste-your-key-here
